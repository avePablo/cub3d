{
   libX11_cond_uninit
   Memcheck:Cond
   obj:*/libX11*
   ...
}

{
   glfw_cond_uninit
   Memcheck:Cond
   obj:*/libglfw*
   ...
}

{
   libGL_cond
   Memcheck:Cond
   obj:*/libGL*
   ...
}

{
   gallium_pthread_once2
