# =============================================================================
# MLX42 + GLFW + libX11 + OpenGL + Mesa + LLVM Valgrind Suppression File
# =============================================================================

# -----------------------------------------------------------------------------
# dlopen / dynamic linker
# -----------------------------------------------------------------------------
{
   dlopen_dl_find_object_update
   Memcheck:Leak
   match-leak-kinds: possible,definite,reachable
   fun:malloc
   ...
   fun:_dl_find_object_update
   ...
}

{
   dlopen_dl_find_object_update_1
   Memcheck:Leak
   match-leak-kinds: possible,definite,reachable
   fun:malloc
   ...
   fun:_dl_find_object_update_1
   ...
}

{
   dlopen_dl_open
   Memcheck:Leak
   match-leak-kinds: possible,definite,reachable
   fun:malloc
   ...
   fun:_dl_open
   ...
}

{
   dlopen_glibc
   Memcheck:Leak
   match-leak-kinds: possible,definite,reachable
   fun:malloc
   ...
   fun:dlopen@@GLIBC_2.34
   ...
}

